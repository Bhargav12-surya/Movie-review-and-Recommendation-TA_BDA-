# Optional, server-side only. No key is needed for the sample application.
TMDB_BEARER_TOKEN=
# Set to a canonical catalog JSON produced by scripts/build_catalog.py.
CINESCOPE_CATALOG=
# Storage locations; defaults to this project's data and models directories.
CINESCOPE_DATA_DIR=
CINESCOPE_MODEL_DIR=
# auto: local fine-tuned transformer, then TF-IDF model, then lexicon baseline.
CINESCOPE_SENTIMENT=auto
# Comma-separated browser origins allowed to call the API in cross-origin deployments.
CINESCOPE_CORS_ORIGINS=
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
CINESCOPE_TRUST_PROXY=false
# Optional local paths to downloaded transformer models.
CINESCOPE_EMBEDDING_MODEL=
CINESCOPE_CHAT_MODEL=
# Optional local faster-whisper directory; never auto-download on an API request.
CINESCOPE_WHISPER_MODEL=
