# Preserve user data, environments and generated artifacts locally.
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Local backup / historical implementation preserved on disk only
temp/
**/temp/

# Credentials: templates remain reviewable.
.env
.env.*
!.env.example
*.pem
*.key

# Original and derived datasets must not be accidentally staged.
data/raw/
data/bronze/
data/silver/
data/gold/
data/processed/
data/exports/
data/events/
data/checkpoints/

# Model weights and runtime state; source and model cards remain visible.
*.safetensors
*.pt
*.pth
*.ckpt
*.joblib
*.npz
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
/models/
.cache/
artifacts/
logs/
debug.log

# JVM and frontend build output.
**/target/
**/.bloop/
**/.metals/
**/node_modules/
**/.next/
**/out/
build/
dist/
*.egg-info/
Thumbs.db
.DS_Store
