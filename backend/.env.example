# Copy manually to backend/.env only if that file does not already exist.
# Enter your own local database password; no default credential is supplied.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=movie_intelligence
DATABASE_USER=movie_app
DATABASE_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
REGISTRATION_ENABLED=true
AUTH_TOKEN_TTL_MINUTES=480
MAXIMUM_REQUEST_BYTES=2097152
REQUESTS_PER_MINUTE=120
MAXIMUM_PENDING_JOBS=1000
MAXIMUM_JOB_ATTEMPTS=6
# Change to cuda only after current driver/torch/precision and artifact tests.
INFERENCE_DEVICE=cpu
# These templates intentionally do not authorize scoring. Point at reviewed copies.
SCORING_CONFIG=scoring/config.example.json
SCORING_APPROVAL=scoring/approval.example.json
HYBRID_CONFIG=configs/recommendation/hybrid.json
TARGET_SCORE_POLICIES={}
# Leave optional path settings UNSET until real validated artifacts exist.
# FACTOR_DIRECTORY=models/recommendation/approved-factor-export
# FACTOR_MAPPING=data/processed/recommendation/approved-factor-mapping.json
# SPEECH_MODEL_PATH=models/speech/approved-local-ct2-model
# SPEECH_PERMISSION_PATH=data/dataset_cards/speech-model-permission.json
# DISCOVERY_MINIMUM_ASPECT_SCORE must be selected and reviewed, never guessed.
POSTER_CACHE=data/processed/posters
REVIEW_EVENT_DIRECTORY=data/events/reviews-live
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
PYTHONDONTWRITEBYTECODE=1
