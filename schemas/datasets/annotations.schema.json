{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human movie-review sentiment and explicit-span annotation",
  "type": "object",
  "required": ["review_id", "review_revision", "movie_id", "review_text",
    "text_sha256", "sentiment", "label_schema_version", "taxonomy_version",
    "annotator_id", "annotation_status", "annotation_guideline_version",
    "training_permitted", "consent_or_license_ref"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "review_revision": {"type": "integer", "minimum": 1},
    "movie_id": {"type": ["string", "integer"]},
    "review_text": {"type": "string", "minLength": 1},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sentiment": {"enum": ["negative", "neutral", "positive", 0, 1, 2]},
    "label_schema_version": {"const": "sentiment-three-class-v1"},
    "taxonomy_version": {"const": "movie-aspects-v1"},
    "annotator_id": {"type": "string", "minLength": 1},
    "adjudicator_id": {"type": "string", "minLength": 1},
    "annotation_status": {"enum": ["annotated", "adjudicated"]},
    "annotation_guideline_version": {"type": "string", "minLength": 1},
    "training_permitted": {"const": true},
    "consent_or_license_ref": {"type": "string", "minLength": 1},
    "aspects": {"type": "array", "items": {"$ref": "#/$defs/aspect"}},
    "themes": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "aspect": {
      "type": "object", "required": ["aspect", "start", "end", "text", "sentiment"],
      "properties": {
        "aspect": {"enum": ["acting", "story", "screenplay", "direction",
          "characters", "cinematography", "visual_effects", "editing", "pacing",
          "music", "sound_design", "dialogue", "worldbuilding", "emotional_impact",
          "originality", "runtime"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "sentiment": {"enum": ["negative", "neutral", "positive", "mixed"]}
      }
    }
  },
  "$comment": "The Python validator enforces original Unicode offsets/evidence/hash, nonoverlapping BIO spans, approved registry, theme evidence and an explicit opt-in for mixed aspect/theme labels. It never creates human labels."
}
