{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:movieintel:review-event:v1",
  "title": "Review analysis event v1",
  "description": "Transport schema; publisher additionally validates probability sums, types, UTC/future bounds and eligibility. Producer attestations require actual DB/provenance verification in Phase9. Delete or held revisions may carry null analysis. No private text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "review_id",
    "review_revision",
    "movie_id",
    "operation",
    "event_time",
    "positive_probability",
    "neutral_probability",
    "negative_probability",
    "model_version",
    "canonical_movie_validated",
    "consent_eligible",
    "moderation_eligible",
    "is_synthetic"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$"
    },
    "review_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "movie_id": {
      "type": "string",
      "description": "Validated internal canonical ID; never a guessed MovieLens/TMDB ID.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$"
    },
    "operation": {
      "enum": [
        "upsert",
        "delete"
      ]
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "positive_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "neutral_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "negative_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_movie_validated": {
      "const": true
    },
    "consent_eligible": {
      "type": "boolean"
    },
    "moderation_eligible": {
      "type": "boolean"
    },
    "is_synthetic": {
      "type": "boolean"
    }
  }
}
